# Superconsciousness Backend Environment Configuration

# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/superconsciousness?schema=public

# Authentication & Security
JWT_SECRET=superconsciousness_development_jwt_secret_change_in_production
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=superconsciousness_development_refresh_secret_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CLIENT_ORIGIN=http://localhost:3000
